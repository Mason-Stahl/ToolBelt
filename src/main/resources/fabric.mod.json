{
	"schemaVersion": 1,
	"id": "toolbelt",
	"version": "${version}",
	"name": "Tool Belt",
	"description": "Declutter your inventory of tools",
	"authors": [
		"gigaherz",
		"Mason-Stahl"
	],
	"contact": {
		"sources": "https://github.com/Mason-Stahl/ToolBelt/tree/fabric"
	},
	"license": "BSD-3-Clause",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.gigaherz.toolbelt.ToolBelt"
		],
		"client": [
			"dev.gigaherz.toolbelt.client.ToolBeltClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	},
	"mixins": [
		"toolbelt.mixins.json",
		{
			"config": "toolbelt.client.mixins.json",
			"environment": "client"
		}
	]
}
